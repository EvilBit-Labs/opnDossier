  <!--
    Port forwards as OPNsense wrote them up to 25.7: <rule> elements directly
    under <nat>, with no uuid attribute and with flags present only when set.
    The first rule uses the default association, which stores a companion pass
    rule under <filter>. The second uses the "Pass" association and has no
    filter rule. The third is a disabled no-RDR rule.
  -->
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
    <rule>
      <protocol>tcp</protocol>
      <interface>wan</interface>
      <category/>
