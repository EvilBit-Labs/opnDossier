  <!--
    Port forwards as OPNsense 26.1 and later store them: the Destination NAT
    model is mounted on <nat><rule>, so each rule is still a direct child of
    <nat>. The rules are deliberately out of <sequence> order.

    The file is a composite of the two rule bodies those releases write. The
    sequence 300 rule has the 26.7.4 and later body, with <audit> in place of
    <created> and <updated>, and the others have the 26.1 to 26.7.3 body. A
    real export holds one of the two, because a save rewrites every rule.
  -->
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
    <rule uuid="b2b2b2b2-0000-4000-8000-000000000001">
      <sequence>100</sequence>
      <disabled>0</disabled>
      <nordr>0</nordr>
      <interface>wan</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>tcp</protocol>
      <source>
        <network/>
        <port/>
        <not>0</not>
      </source>
      <destination>
        <network>wanip</network>
        <port>443</port>
        <not>0</not>
      </destination>
      <target>192.168.10.50</target>
      <local-port>8443</local-port>
      <poolopts/>
      <log>0</log>
      <category/>
      <descr>HTTPS to web server</descr>
      <tag/>
      <tagged/>
      <nosync>0</nosync>
      <natreflection/>
      <pass/>
      <associated-rule-id/>
      <created>
        <username>root@192.0.2.10</username>
        <time>1759312345.12</time>
        <description>/firewall_nat_edit.php made changes</description>
      </created>
      <updated>
        <username>root@192.0.2.10</username>
        <time>1759312345.12</time>
        <description>/firewall_nat_edit.php made changes</description>
      </updated>
    </rule>
    <rule uuid="b2b2b2b2-0000-4000-8000-000000000003">
      <sequence>300</sequence>
      <disabled>0</disabled>
      <nordr>0</nordr>
      <interface>wan,opt1</interface>
      <ipprotocol/>
